          "param": "TorqueParamsOverrideEnabled",
          "values": {
           "true": "(Real-Time & Offline)",
           "false": "(Offline Only)"
          }
         },
         "min": 0.0,
         "max": 1.0,
         "step": 0.01,
         "enablement": [
          {
           "type": "param",
           "key": "CustomTorqueParams",
           "equals": true
          },
          {
           "type": "any",
           "conditions": [
            {
             "type": "param",
             "key": "TorqueParamsOverrideEnabled",
             "equals": true
            },
            {
             "type": "offroad_only"
            }
           ]
          }
