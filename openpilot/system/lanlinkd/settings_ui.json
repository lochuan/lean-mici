        {
         "key": "BlinkerMinLateralControlSpeed",
         "widget": "option",
         "title": "暂停横向控制的最低车速",
         "min": 0,
         "max": 255,
         "step": 5,
         "unit": {
          "metric": "km/h",
          "imperial": "mph"
         },
         "enablement": [
          {
           "type": "param",
           "key": "BlinkerPauseLateralControl",
           "equals": true
          }
         ]
        },
        {
         "key": "BlinkerLateralReengageDelay",
         "widget": "option",
         "title": "转向灯后延迟",
         "min": 0,
         "max": 10,
         "step": 1,
         "unit": "second",
         "enablement": [
          {
           "type": "param",
           "key": "BlinkerPauseLateralControl",
           "equals": true
          }
         ]
        }
       ]
      }
     ]
    },
    {
     "id": "torque",
